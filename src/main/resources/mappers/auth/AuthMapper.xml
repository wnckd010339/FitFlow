<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.acorn.gymmanagement.auth.mapper.AuthMapper">
    <select id="findByLoginId" resultType="com.acorn.gymmanagement.auth.model.UserAccount">
        SELECT id, login_id, password, role, status, created_at, updated_at
        FROM users
        WHERE login_id = #{loginId}
    </select>
</mapper>
